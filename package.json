{
  "name": "nekochannel",
  "productName": "Nekochannel",
  "version": "0.2.0",
  "description": "Desktop channel hub — multi-account WhatsApp (and later email) with reader + agent.",
  "repository": "github:yughoz/nekochannel",
  "main": "shell/main.js",
  "author": "Nekoding",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/fix-mac-appname.js",
    "sync-reader": "node scripts/sync-reader.js",
    "test": "node --test",
    "dist": "electron-builder"
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "xyz.nekoding.nekochannel",
    "productName": "Nekochannel",
    "directories": { "output": "dist" },
    "linux": { "target": ["AppImage"], "category": "Network" },
    "mac": { "target": ["dmg"], "category": "public.app-category.social-networking" },
    "win": { "target": ["nsis"] }
  }
}
