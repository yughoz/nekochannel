# Optional lifecycle configuration: NEKOCHANNEL_ENV=/absolute/path/to/config.env
# Desktop integrations use encrypted Settings, never write .env.
# Provider/key variables below are compatibility for unmanaged backend callers.
# Desktop initial import uses process/app-owned .env only, not this selected file.
NEKOCHANNEL_INGEST_PORT=4317
NEKOCHANNEL_CHAT_PORT=4318
NEKOCHANNEL_MCP_PORT=4319
# Unmanaged backend only; desktop MCP toggle/port/encrypted key live in Settings.
# NEKOCHANNEL_MCP_KEY=
CHAT_MODEL_URL=
CHAT_MODEL_NAME=
CHAT_MODEL_KEY=
CHAT_MODE=fc
# Optional compatibility fallback: SUMMARY_MODEL_URL/NAME/KEY.
# One-time import ONLY into a fresh userData/data directory. Remove after success.
# NEKOCHANNEL_IMPORT_SQLITE=/absolute/path/to/legacy/wa.sqlite
