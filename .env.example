# Explicitly load this file with NEKOCHANNEL_ENV=/absolute/path/to/config.env
# Settings writes a separate private .env inside the application's user-data dir.
NEKOCHANNEL_INGEST_PORT=4317
NEKOCHANNEL_CHAT_PORT=4318
NEKOCHANNEL_MCP_PORT=4319
# Optional; otherwise a random key is saved to userData/mcp-key (0600).
# NEKOCHANNEL_MCP_KEY=
CHAT_MODEL_URL=
CHAT_MODEL_NAME=
CHAT_MODEL_KEY=
CHAT_MODE=fc
# Optional compatibility fallback: SUMMARY_MODEL_URL/NAME/KEY.
# One-time import ONLY into a fresh userData/data directory. Remove after success.
# NEKOCHANNEL_IMPORT_SQLITE=/absolute/path/to/legacy/wa.sqlite
